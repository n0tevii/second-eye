# 复制本文件为 .env 后填写。不要提交填值后的文件。
# 管理账号和部署入口在环境变量中配置；业务凭据可在受保护的设置页填写。

SECOND_EYE_VERSION=v0.2.0
APP_PORT=18000
NOVNC_PORT=16080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password

# noVNC 默认不启动。临时启用前，在 data/.novnc-password 写入独立强密码。
ENABLE_NOVNC=0
NOVNC_PASSWORD_FILE=/app/data/.novnc-password

# 闲鱼登录 Cookie；优先在受保护的登录窗口或设置页中填写。
XIANYU_COOKIE=

# OpenAI 兼容大模型服务
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=glm-4.7-flash
LLM_API_FORMAT=chat_completions

# Server酱
SERVERCHAN_SENDKEY=
SERVERCHAN_ENABLED=true

# 视觉模型
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=glm-4.6v-flash
VISION_API_FORMAT=chat_completions
VISION_ENABLED=true

# 企业微信、飞书
WECOM_WEBHOOK=
WECOM_ROBOT_ENABLED=true
FEISHU_WEBHOOK=
FEISHU_SECRET=
FEISHU_ENABLED=true

# Gotify 只配置外部已有服务；本项目默认不启动 Gotify 容器。
GOTIFY_URL=
GOTIFY_TOKEN=
GOTIFY_PRIORITY=5
GOTIFY_ENABLED=false

# 可选 HTTP 代理
PROXY=

DEFAULT_CRAWL_INTERVAL_MINUTES=20
DEFAULT_CRAWL_JITTER_MINUTES=10
DATABASE_URL=sqlite:///data/goodprice.db
